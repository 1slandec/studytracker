@page
@model Disable2faModel
@{
    ViewData["Title"] = "Отключение двухфакторной аутентификации (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Это действие только отключает 2FA.</strong>
    </p>
    <p>
        Отключение 2FA не меняет ключи, используемые в приложениях-аутентификаторах. Чтобы сменить ключ,
        нужно <a asp-page="./ResetAuthenticator">сбросить ключи аутентификатора</a>.
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Отключить 2FA</button>
    </form>
</div>

