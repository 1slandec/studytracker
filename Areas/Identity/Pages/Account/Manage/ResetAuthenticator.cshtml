@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Сброс ключа аутентификатора";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>После сброса ключа приложение-аутентификатор не будет работать, пока вы не настроите его заново.</strong>
    </p>
    <p>
        Этот процесс отключит 2FA до повторного подтверждения приложения-аутентификатора.
        Если не завершить настройку, можно потерять доступ к аккаунту.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Сбросить ключ аутентификатора</button>
    </form>
</div>

