@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Вход по резервному коду";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    Вы запросили вход с помощью резервного кода. Такой вход не будет запомнен, пока вы не введете код
    из приложения-аутентификатора или не отключите 2FA и не войдете снова.
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Резервный код" />
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Войти</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
