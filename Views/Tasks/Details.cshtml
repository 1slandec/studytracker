@model StudyTaskDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<partial name="_Alerts" />

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <a class="small text-decoration-none" asp-action="Index" asp-route-courseId="@Model.CourseId">Назад к заданиям</a>
        <h1 class="h3 mt-2 mb-1">@Model.Title</h1>
        <div class="text-muted">@Model.CourseName</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanManageTask)
        {
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Изменить</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Удалить</a>
        }
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Описание</dt>
    <dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Дедлайн</dt>
    <dd class="col-sm-9">
        <span class="@(Model.IsOverdue ? "text-danger fw-semibold" : string.Empty)">@Model.Deadline.ToString("dd.MM.yyyy")</span>
    </dd>
    <dt class="col-sm-3">Статус</dt>
    <dd class="col-sm-9"><span class="badge text-bg-secondary">@Model.StatusName</span></dd>
</dl>

@if (Model.CanChangeStatus)
{
    <form asp-action="ChangeStatus" method="post" class="row g-2 align-items-end form-narrow">
        <input type="hidden" name="TaskId" value="@Model.Id" />
        <input type="hidden" name="ReturnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
        <div class="col-md-8">
            <label class="form-label" for="Status">Мой статус</label>
            <select class="form-select" id="Status" name="Status">
                @foreach (var status in Enum.GetValues<TaskStatusType>())
                {
                    if (Model.Status == status)
                    {
                        <option value="@status" selected>@status.ToDisplayName()</option>
                    }
                    else
                    {
                        <option value="@status">@status.ToDisplayName()</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-auto">
            <button class="btn btn-primary" type="submit">Сохранить статус</button>
        </div>
    </form>
}
