@model StudyTaskFormViewModel

@{
    ViewData["Title"] = "Удаление задания";
}

<partial name="_Alerts" />

<h1 class="h3 mb-3">Удаление задания</h1>
<p>Задание <strong>@Model.Title</strong> будет удалено.</p>

<dl class="row">
    <dt class="col-sm-3">Курс</dt>
    <dd class="col-sm-9">@Model.CourseName</dd>
    <dt class="col-sm-3">Дедлайн</dt>
    <dd class="col-sm-9">@Model.Deadline.ToString("dd.MM.yyyy")</dd>
    <dt class="col-sm-3">Описание</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Отмена</a>
</form>
