@model StudyTaskListViewModel

@{
    ViewData["Title"] = "Задания";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<partial name="_Alerts" />

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
    <div>
        <a class="small text-decoration-none" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">Назад к курсу</a>
        <h1 class="h3 mt-2 mb-1">Задания</h1>
        <div class="text-muted">@Model.CourseName</div>
    </div>
    @if (Model.CanManageTasks)
    {
        <a class="btn btn-primary" asp-action="Create" asp-route-courseId="@Model.CourseId">Добавить задание</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="courseId" value="@Model.CourseId" />
    <div class="col-md-4">
        <label class="form-label" for="statusFilter">Статус</label>
        <select class="form-select" id="statusFilter" name="statusFilter">
            @if (Model.StatusFilter is null)
            {
                <option value="" selected>Все задания</option>
            }
            else
            {
                <option value="">Все задания</option>
            }
            @foreach (var status in Enum.GetValues<TaskStatusType>())
            {
                if (Model.StatusFilter == status)
                {
                    <option value="@status" selected>@status.ToDisplayName()</option>
                }
                else
                {
                    <option value="@status">@status.ToDisplayName()</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="sortOrder">Сортировка</label>
        <select class="form-select" id="sortOrder" name="sortOrder">
            @if (string.IsNullOrWhiteSpace(Model.SortOrder))
            {
                <option value="" selected>Без сортировки</option>
            }
            else
            {
                <option value="">Без сортировки</option>
            }
            @if (Model.SortOrder == StudyTaskService.SortByDeadlineAscending)
            {
                <option value="@StudyTaskService.SortByDeadlineAscending" selected>Дедлайн по возрастанию</option>
            }
            else
            {
                <option value="@StudyTaskService.SortByDeadlineAscending">Дедлайн по возрастанию</option>
            }
            @if (Model.SortOrder == StudyTaskService.SortByDeadlineDescending)
            {
                <option value="@StudyTaskService.SortByDeadlineDescending" selected>Дедлайн по убыванию</option>
            }
            else
            {
                <option value="@StudyTaskService.SortByDeadlineDescending">Дедлайн по убыванию</option>
            }
        </select>
    </div>
    <div class="col-md-auto">
        <button class="btn btn-outline-primary" type="submit">Применить</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Задание</th>
                <th>Дедлайн</th>
                <th>Статус</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Tasks.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-muted">Заданий по выбранным условиям нет.</td>
            </tr>
        }
        else
        {
            foreach (var task in Model.Tasks)
            {
                <tr class="@(task.IsOverdue ? "table-danger" : string.Empty)">
                    <td>
                        <div class="fw-semibold">@task.Title</div>
                        <div class="text-muted small">@task.Description</div>
                    </td>
                    <td>@task.Deadline.ToString("dd.MM.yyyy")</td>
                    <td class="status-column">
                        @if (task.CanChangeStatus)
                        {
                            <form asp-action="ChangeStatus" method="post" class="d-flex gap-2 justify-content-end justify-content-md-start">
                                <input type="hidden" name="TaskId" value="@task.Id" />
                                <input type="hidden" name="ReturnUrl" value="@returnUrl" />
                                <select class="form-select form-select-sm status-select" name="Status" aria-label="Статус задания">
                                    @foreach (var status in Enum.GetValues<TaskStatusType>())
                                    {
                                        if (task.Status == status)
                                        {
                                            <option value="@status" selected>@status.ToDisplayName()</option>
                                        }
                                        else
                                        {
                                            <option value="@status">@status.ToDisplayName()</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-primary" type="submit">Сохранить</button>
                            </form>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">@task.StatusName</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Действия задания">
                            <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@task.Id">Открыть</a>
                            @if (task.CanManageTask)
                            {
                                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@task.Id">Изменить</a>
                                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@task.Id">Удалить</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
